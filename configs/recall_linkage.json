  SERVICE-01: {sentiment: any,   content_type_pref: [tutorial, qa, encyclopedia, video_long], role: 主召回知识, weight: 1.0, time_window_days: null}
  SERVICE-02: {sentiment: any,   content_type_pref: [tutorial, qa, encyclopedia],role: 主召回知识, weight: 1.0, time_window_days: null}
  SERVICE-03: {sentiment: any,   content_type_pref: [encyclopedia, article],     role: 主召回知识, weight: 1.0, time_window_days: null}
  SYSTEM-01:  {sentiment: "-",   content_type_pref: [],                          role: 不走内容召回, weight: 0.0, time_window_days: null}
  SYSTEM-02:  {sentiment: "-",   content_type_pref: [],                          role: 不走内容召回, weight: 0.0, time_window_days: null}
  SYSTEM-03:  {sentiment: "-",   content_type_pref: [],                          role: 不走内容召回, weight: 0.0, time_window_days: null}
  SYSTEM-04:  {sentiment: "-",   content_type_pref: [],                          role: 不走内容召回, weight: 0.0, time_window_days: null}
  SYSTEM-05:  {sentiment: "-",   content_type_pref: [news, article],             role: 兜底通用召回, weight: 0.3, time_window_days: 7}

# time_anchor 槽位 → 召回时间窗默认值（无显式时间词时）
time_anchor_defaults:
  最新:       {sort: freshness_desc, window_days: 7}
  历史时点:   {sort: relevance_desc, window_days: null}
  区间:       {sort: relevance_desc, window_days: null}
  未来:       {sort: relevance_desc, window_days: null}
  无:         {sort: relevance_desc, window_days: null}
