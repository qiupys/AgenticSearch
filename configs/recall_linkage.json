  QUANT-04:   {sentiment: any,   content_type_pref: [report, tutorial],          role: 辅助, weight: 0.4, time_window_days: null}
  TRADE-01:   {sentiment: mixed, content_type_pref: [article, qa, live],         role: 辅助, weight: 0.5, time_window_days: null}
